# =============================================================================
#  SECRETS FILE TEMPLATE
#  Copy this file to ".env" (same folder) and fill in ONLY what you need.
#  The .env file is private: it is excluded from Git and from backups,
#  and its values are removed from logs. Never paste these values into chat.
# =============================================================================

# Optional: EODHD market data API token (only if data.provider = eodhd)
EODHD_API_TOKEN=

# Optional: email alerts (only if notifications.email_enabled = true)
# Use an app-specific password from your email provider, not your main password.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=
